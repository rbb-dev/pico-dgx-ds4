# ~/.config/systemd/user/pico-engine.service. Rank 0 runs in the foreground as this unit's main process; ranks 1-3 are
# started on the workers by pico-ctl.sh prepare, and stopped by rank 0 itself when this unit stops.
[Unit]
Description=pico engine: rank 0 in the foreground, ranks 1-3 on the workers
After=network-online.target
# a failing start is tried again with a growing delay, with no burst limit
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/dsgb10
EnvironmentFile=%h/dsgb10/pico.env
# prepare: GPU clock, the files every Spark needs, the page cache, the memory check, then ranks 1-3
ExecStartPre=%h/dsgb10/bin/pico-ctl.sh prepare
# the same arguments every rank got from prepare (pico-ctl.sh engine_args), and --rank 0
ExecStart=%h/dsgb10/bin/dsgb10_rank --rank 0 --mode serve --socket %h/dsgb10/run/engine.sock --disk-tag service --keep-gib ${KEEP_GIB} $ENGINE_ARGS
# ready: waits for rank 0's socket; the second line clears the restart delay after a start that served
ExecStartPost=%h/dsgb10/bin/pico-ctl.sh ready
ExecStartPost=/usr/bin/systemctl --user reset-failed pico-engine.service
# SIGTERM to rank 0: it ends the request in flight, keeps the sessions (KEEP_GIB) and stops ranks 1-3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
# reap: what is left of ranks 1-3 on the workers
ExecStopPost=%h/dsgb10/bin/pico-ctl.sh reap
Restart=always
RestartSec=10s
RestartSteps=6
RestartMaxDelaySec=1h
TimeoutStartSec=40min

[Install]
WantedBy=default.target
