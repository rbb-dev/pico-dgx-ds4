# ~/dsgb10/pico.env on rank 0: the settings pico-engine.service, pico-front.service, pico-media.service and pico-ctl.sh read.
# systemd's EnvironmentFile syntax: KEY=value, no quotes, no inline comments, no shell expansion (a ~ stays a ~ and is
# not the home directory, so paths that are not the engine's own --weights use the full /home/<user>/... form; the
# engine expands a leading ~/ in --weights itself). A $VAR in a unit's ExecStart splits on spaces.
# <user> is the login that owns ~/dsgb10 on all four Sparks (the same name on each).

# ENGINE_ARGS: every rank gets this line. It holds only what describes one machine: the abliteration file, each rank's
# quarter of the image encoder, each rank's weight file and the confidence network's file. Everything else the engine runs
# with is its default: the window (4M tokens), 32 lines, the memory left free on every Spark (--pool-free-gib 6.3), the
# Engram cache in the display reservation, the SSD tier (512 GiB), copy drafting, batched drafting and its cost model, the
# 4-bit draft head and the Markov head, the certified head, direct ring on one switch, the balanced reduce-scatter, the prefill
# tuning, the wide-step switches, the decode index scan split over the ranks, the split cache, the prefill passes of
# 16,384 rows, and the caps of the front-end and the media worker. The measurements in the README are of these defaults
# (the list is README.md's "As served"; `engine/server/served.h` holds it). To change one, name it here (--slots 16,
# --setenv DSGB10_X=0, --no-draft-head4, --kv-split off ...): a named setting wins over the default.
# Copy drafting uses the engine's built-in table; to use a fitted one add
# --setenv DSGB10_COPY_TABLE=/home/<user>/dsgb10/copy-T.txt (same file, same path on every Spark: docs/batching.md).
# Leave out --ablit and --vision-weights to serve without them. Leave out DSGB10_CF_MLP to serve without the confidence
# network (the one-session confidence gate and DSGB10_BATCH_CF then have nothing to read).
ENGINE_ARGS=--ablit /home/<user>/dsgb10/ablit.bin --vision-weights /home/<user>/dsgb10/vision/vision.rank{rank}.dsw --weights ~/dsgb10/weights/rank{rank}.dsw --setenv DSGB10_CF_MLP=/home/<user>/dsgb10/bin/cfmlp_cml.bin

# Sessions a planned stop keeps on every Spark's SSD, in GiB (0: none). A start needs MemFree of at least MIN_AVAIL_GIB
# on every Spark after the page cache is dropped (a rank takes about 90 GiB). GPU_CLOCK is the limit in MHz set on all
# four Sparks at every start: 2400, 2200, 2000 or 1800 (never unlocked).
KEEP_GIB=64
MIN_AVAIL_GIB=100
GPU_CLOCK=2200

# The front-end: its port, the address of rank 0 on your LAN (besides 127.0.0.1), how long a request is held while the
# engine restarts (seconds), and its other arguments: the checkpoint's tokenizer, each Spark's node sampler (rail A address,
# port 9760) for NODE HEALTH, the media worker's address and the fan and clock tool. The served settings are the front-end's
# defaults: the prompt encoding 1017, the served name deepseek-v4.1-flash-1017, thinking on at effort 75, the response cap
# (1,048,576 tokens), sampling temperature 1.0 and top-p 0.95, and the front-end's memory cap (--front-mib 840, the same number
# as the engine's). --no-thinking, --effort, --max-tokens and the rest take another value when named. Add --listen ADDR:PORT for
# another address; never 0.0.0.0.
PORT=8000
LAN_ADDR=<rank0-lan-address>
HOLD_S=900
FRONT_ARGS=--tokenizer /home/<user>/dsgb10/model/tokenizer.json --node-stats <rank0-rail-a-address>:9760,<rank1-rail-a-address>:9760,<rank2-rail-a-address>:9760,<rank3-rail-a-address>:9760 --media-addr 127.0.0.1:18951 --fan-tool /usr/local/bin/dgx-fan-fleet

# The checkpoint's folder (pico-media.service mounts its inference/config.json, read only) and the media worker's image tag
# (docker build -f Dockerfile.media-worker -t pico-media:rev1 in tools/vision).
MODEL_SNAPSHOT=/home/<user>/dsgb10/model
MEDIA_IMAGE=pico-media:rev1

# The clock tool (ds41f-4xgx10-switchless/tools/gpu-clock, installed by pico-ctl.sh install into ~/dsgb10/bin): run as
# "gpu-clock LIMIT [ssh targets...]" it sets the GPU clock limit (2400, 2200, 2000 or 1800 MHz; never unlocked) on this Spark
# and each target, and records {"limit","at","ok","error"} in GPU_CLOCK_STATE on the Spark it runs on (the targets are set,
# not recorded). pico-ctl.sh runs it on rank 0 at every start (GPU_CLOCK_TOOL); the dashboard's COOLING AND CLOCK box runs it
# through dgx-fan-fleet (DGX_FAN_CLOCK_TOOL). Both state settings name the same file.
# Leave GPU_CLOCK_TOOL out to have pico-ctl.sh call "sudo -n nvidia-smi -lgc 0,LIMIT" itself.
GPU_CLOCK_TOOL=/home/<user>/dsgb10/bin/gpu-clock
GPU_CLOCK_STATE=/home/<user>/dsgb10/run/gpu-clock-state

# The fan tool (dgx-fan-fleet, from the dgx-spark-fan-control project): the other three Sparks as ssh targets, the clock tool
# it runs for the dashboard's clock list, and the file where that tool records the limit (on the Spark it runs on). Leave these out, and
# --fan-tool in FRONT_ARGS, to have no COOLING AND CLOCK box.
DGX_FAN_NODES=<rank1-lan-address> <rank2-lan-address> <rank3-lan-address>
DGX_FAN_CLOCK_TOOL=/home/<user>/dsgb10/bin/gpu-clock
DGX_FAN_CLOCK_STATE=/home/<user>/dsgb10/run/gpu-clock-state
